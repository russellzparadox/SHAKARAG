FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY rag/ ./rag/
COPY scripts/ ./scripts/
COPY api/ ./api/

EXPOSE 8100
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8100"]
