FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pymssql onnxruntime

COPY rag/ ./rag/
COPY scripts/ ./scripts/
COPY api/ ./api/
COPY webapp/ ./webapp/

ENV CHROMA_DIR=/data/chroma
VOLUME ["/data/chroma"]

EXPOSE 8111

WORKDIR /app/webapp
CMD ["sh", "-c", "python manage.py migrate --noinput && python manage.py runserver 0.0.0.0:8111"]
