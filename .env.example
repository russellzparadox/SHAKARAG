DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USER=shaka
DB_PASSWORD=change-me
DB_NAME=shaka
# For warehouses you can skip host/port and give a full SQLAlchemy URL instead:
# DB_DIALECT=snowflake
# DB_URL=snowflake://user:pass@account/db/schema?warehouse=COMPUTE_WH

CHROMA_DIR=.chroma
COLLECTION=odoo_schema

EMBED_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small

LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:7b
LLM_API_KEY=
LLM_TEMPERATURE=0.1

TOP_K=8
CONTEXT_CHAR_BUDGET=14000
MAX_ROWS=100
STATEMENT_TIMEOUT_MS=15000
